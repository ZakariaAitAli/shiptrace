{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(python3 -I scripts/check_repo.py)",
      "Bash(python3 -I .claude/hooks/tests/test_hooks.py)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run lint-imports *)",
      "Bash(scripts/verify.sh --fast)",
      "Bash(uv run --frozen pytest tests/unit *)"
    ],
    "deny": [
      "Read(~/.gnupg/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfstate*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(docker push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws *)"
    ],
    "ask": [
      "Bash(scripts/verify.sh)",
      "Bash(scripts/smoke.sh)",
      "Bash(scripts/commit.py *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_files.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_python.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "env": {
    "UV_CACHE_DIR": ".uv-cache",
    "UV_NO_SYNC": "1",
    "UV_NO_CONFIG": "1"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "scripts/verify.sh",
      "scripts/smoke.sh",
      "scripts/commit.py *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.claude/.credentials.json",
        "~/.gnupg",
        "~/.docker/config.json",
        "~/.netrc",
        "~/.pgpass",
        ".env",
        ".env.local",
        ".env.production"
      ],
      "denyWrite": [
        "scripts",
        "compose.yaml",
        "compose.override.yaml",
        "pyproject.toml",
        "uv.lock",
        ".venv",
        ".git/config",
        ".gitleaks.toml",
        "uv.toml",
        ".python-version",
        ".git"
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  }
}
