# Copy to .env and replace every value. Generate each with: openssl rand -base64 24
SHIPTRACE_ADMIN_PASSWORD=
SHIPTRACE_APP_PASSWORD=
SHIPTRACE_MIGRATOR_PASSWORD=

# URL-encode passwords in these two values.
SHIPTRACE_ENVIRONMENT=local
SHIPTRACE_DATABASE_URL=postgresql+psycopg://shiptrace_app:<password>@127.0.0.1:5432/shiptrace
SHIPTRACE_MIGRATOR_DATABASE_URL=postgresql+psycopg://shiptrace_migrator:<password>@127.0.0.1:5432/shiptrace
